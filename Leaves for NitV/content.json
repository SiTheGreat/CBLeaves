{   
	"Format": "2.0.6",

	"ConfigSchema":{

		"CrossoverContent": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, items added for crossovers will not appear or be counted for collection when their respective mods are installed."
		},

	},
	
	"Changes": [

        // Base Content //////////////////////////////////////////////////////////

        {
			"Action": "Include",
			"FromFile": "leaves.json",
		},

		{
			"Action": "Include",
			"FromFile": "rewards.json",
		},

        // Crossover Content //////////////////////////////////////////////////////////

        // Book Collecting
        {
			"Action": "Include",
			"FromFile": "Crossovers/BC/books.json",
            "When": {
			    "HasMod: |contains=Si.BC": true,
				"HasFlag: |contains={{ModId}}_UnlockedBooks": true,
				"CrossoverContent": true
		    },
		},

		// SVE
		{
			"Action": "Include",
			"FromFile": "Crossovers/SVE/SVELeaves.json",
            "When": {
			    "HasMod: |contains=FlashShifter.StardewValleyExpandedCP": true,
				"CrossoverContent": true
		    },
		},

		// Tortilla Trees
		{
			"Action": "Include",
			"FromFile": "Crossovers/TortillaTrees/TortillaLeaves.json",
            "When": {
			    "HasMod: |contains=Si.TortillaTree": true,
				"CrossoverContent": true
		    },
		},

		// Stalac Town
		{
			"Action": "Include",
			"FromFile": "Crossovers/StalacTown/StalacTownLeaves.json",
            "When": {
			    "HasMod: |contains=Si.ST": true,
				"CrossoverContent": true
		    },
		},

	]
}