{   
	"Format": "2.0.6",

	"ConfigSchema":{

		"SVELeaves": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, leaves added when the Stardew Valley Expanded mod is installed will not appear or be counted for collection."
		},

		"TortillaLeaves": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, leaves added when the Tortilla Trees mod is installed will not appear or be counted for collection."
		},

		"Books": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, books added when the Book Collecting mod is installed will not appear or be counted for collection. This includes crossover books."
		},

	},
	
	"Changes": [

        // Base Content //////////////////////////////////////////////////////////

        {
			"Action": "Include",
			"FromFile": "leaves.json",
		},

		{
			"Action": "Include",
			"FromFile": "rewards.json",
		},

        // Crossover Content //////////////////////////////////////////////////////////

        // Book Collecting
        {
			"Action": "Include",
			"FromFile": "Crossovers/BC/books.json",
            "When": {
			    "HasMod: |contains=Si.BC": true,
				"HasWalletItem |contains=MagnifyingGlass": true,
				"Books": true
		    },
		},

		// SVE
		{
			"Action": "Include",
			"FromFile": "Crossovers/SVE/SVELeaves.json",
            "When": {
			    "HasMod: |contains=FlashShifter.StardewValleyExpandedCP": true,
				"SVELeaves": true
		    },
		},

		// Tortilla Trees
		{
			"Action": "Include",
			"FromFile": "Crossovers/TortillaTrees/TortillaLeaves.json",
            "When": {
			    "HasMod: |contains=Si.TortillaTree": true,
				"TortillaLeaves": true
		    },
		},

	]
}